      "sha256": "c9f6171d01852b23d56e4787c523caa21c589015a3fe639a0f376eb2d75e18a9"
    },
    {
      "id": "practice-075",
      "text": "见到你真好。",
      "audio": "audio/slow-v2/practice-075.mp3",
      "bytes": 14976,
      "sha256": "8604ef89c308daf2c48375f50696d6ab5b2f421a6e8483aa0278826009db328f"
    },
    {
      "id": "practice-076",
      "text": "我想和你说话。",
      "audio": "audio/slow-v2/practice-076.mp3",
      "bytes": 15552,
      "sha256": "0e33ed347abb13e51daf63086556798363574548e70ed9cbd396c80964d0c1bd"
    },
    {
      "id": "practice-077",
      "text": "我想看看照片。",
      "audio": "audio/slow-v2/practice-077.mp3",
      "bytes": 16704,
      "sha256": "889dc7c7007434bf3c98d1fc7bfb55cfb357e76ccbe0830d453d7c1f95939315"
    },
    {
      "id": "practice-078",
      "text": "我们聊一会儿。",
      "audio": "audio/slow-v2/practice-078.mp3",
      "bytes": 13248,
      "sha256": "5084b832b34323576b70c1c101834643faf5ded2a283d1e7cd38a83d48b4c8cf"
    },
    {
      "id": "practice-079",
      "text": "我想听音乐。",
      "audio": "audio/slow-v2/practice-079.mp3",
      "bytes": 14544,
      "sha256": "dc80bf74e171010ab6dabc1ab2871d9afb1171211b0093b85f59bf0656add13c"
    },
    {
      "id": "practice-080",
      "text": "明天再来看我。",
      "audio": "audio/slow-v2/practice-080.mp3",
      "bytes": 15984,
      "sha256": "b9e35d1f7d0cb336e58f107f09229c0d6b0336c316f80146d1702cb5831f6721"
    },
    {
      "id": "practice-081",
      "text": "今天天气好。",
      "audio": "audio/slow-v2/practice-081.mp3",
      "bytes": 15264,
      "sha256": "b32121b17e296d132d75ced4fc2141ac22d9ce9821a553dc5b60e183f3b11b5c"
    },
    {
      "id": "practice-082",
      "text": "外面下雨了。",
      "audio": "audio/slow-v2/practice-082.mp3",
      "bytes": 14688,
      "sha256": "33cabae0b20aae5299d4e39995602a708aec6c1a5a83eb4e46c83a36d5157a9b"
    },
    {
      "id": "practice-083",
      "text": "太阳出来了。",
      "audio": "audio/slow-v2/practice-083.mp3",
      "bytes": 13824,
      "sha256": "62c86742c1904254914f9979b5e3a0d5e73b7c2580da03ba390832999df2197c"
    },
    {
      "id": "practice-084",
      "text": "我想看看窗外。",
      "audio": "audio/slow-v2/practice-084.mp3",
      "bytes": 15984,
      "sha256": "bb099cfee9712f950c20c6713dbe1bbdd8fecc3b6af1a87690223de50b6a5852"
    },
    {
      "id": "practice-085",
      "text": "我想看电视。",
      "audio": "audio/slow-v2/practice-085.mp3",
      "bytes": 14976,
      "sha256": "5d093bb4d9763624470efaeaf23f58ff2c8051de986cd143dc9cfabc8907f368"
    },
    {
      "id": "practice-086",
      "text": "声音小一点。",
      "audio": "audio/slow-v2/practice-086.mp3",
      "bytes": 15552,
      "sha256": "0624059a97dfb3e4defd7525e425f315bd46499ee10bd5a19aa659eac198034a"
    },
    {
      "id": "practice-087",
      "text": "声音大一点。",
      "audio": "audio/slow-v2/practice-087.mp3",
      "bytes": 15120,
      "sha256": "fa40e9ef9f90f03e9aef28ad93a3b90b2eef14ed72c164d038e69e81fafd69dd"
    },
    {
      "id": "practice-088",
      "text": "把窗帘拉开。",
      "audio": "audio/slow-v2/practice-088.mp3",
      "bytes": 14976,
      "sha256": "1ecd77c13b22609efdb50f3993ec1c793b7fc00989cbaa7a6bb6724df46a75c6"
    },
    {
      "id": "practice-089",
      "text": "把手机给我。",
      "audio": "audio/slow-v2/practice-089.mp3",
      "bytes": 14688,
      "sha256": "e66fc7d499de614131ae996505c8e8f7eccf72c30902eb27c0bfa3aa7e4c6e64"
    },
    {
      "id": "practice-090",
      "text": "现在几点了？",
      "audio": "audio/slow-v2/practice-090.mp3",
      "bytes": 14688,
      "sha256": "1759f277a8123b1844cb1425c9c82a91a6404138aba95d4633ef14202c51e82f"
    },
    {
      "id": "practice-091",
      "text": "我准备好了。",
      "audio": "audio/slow-v2/practice-091.mp3",
      "bytes": 14112,
      "sha256": "7ba47e02609f3b4607b0fed786e21943a874aebe39bb0fd93b3182101ea8b3cf"
    },
    {
      "id": "practice-092",
      "text": "我想试一试。",
      "audio": "audio/slow-v2/practice-092.mp3",
      "bytes": 15120,
      "sha256": "ddc5a3c7d1acff3e8b7855bed0a5b4b4d3bbff064c6d08351e957ce4e59844c4"
    },
    {
      "id": "practice-093",
      "text": "我们慢慢来。",
      "audio": "audio/slow-v2/practice-093.mp3",
      "bytes": 14256,
      "sha256": "3fdaa81f40728011af240833f556ad4c835012d0bce9281f28c9a53450cd60b8"
    },
    {
      "id": "practice-094",
      "text": "我再说一次。",
      "audio": "audio/slow-v2/practice-094.mp3",
      "bytes": 14400,
      "sha256": "9b637e0f05baeafa98368bde97258f377199d0868a29ee985901fbc50a7dc67a"
    },
    {
      "id": "practice-095",
      "text": "这句有点难。",
      "audio": "audio/slow-v2/practice-095.mp3",
      "bytes": 14256,
      "sha256": "702981cf08750156e70d6fabfe643c276d2c5e1e806dc720f890fbd1109f7228"
    },
    {
      "id": "practice-096",
      "text": "这句我会说。",
      "audio": "audio/slow-v2/practice-096.mp3",
      "bytes": 14544,
      "sha256": "31cb2201cdf63f352845719f85468418540371204b66c7fdc22f243375206c2a"
    },
    {
      "id": "practice-097",
      "text": "让我歇一会儿。",
      "audio": "audio/slow-v2/practice-097.mp3",
      "bytes": 13968,
      "sha256": "95e90797668004137c16761ff06f33982054b7cfb5f2d4923dda106bcc1fa32d"
    },
    {
      "id": "practice-098",
      "text": "今天先到这里。",
      "audio": "audio/slow-v2/practice-098.mp3",
      "bytes": 16272,
      "sha256": "4b714bf46fbf3711ccbc5c114d4e45923bf27406949951d8b11a430980d5b0fc"
    },
    {
      "id": "practice-099",
      "text": "下次继续练。",
      "audio": "audio/slow-v2/practice-099.mp3",
      "bytes": 15984,
      "sha256": "93f058e0650134e2ef753e70730b688f949bbc8cb5c99c7d53ee7ce4e150b49c"
    },
    {
      "id": "practice-100",
      "text": "我说完了。",
      "audio": "audio/slow-v2/practice-100.mp3",
      "bytes": 13248,
      "sha256": "12f3b220054ad33d52aeb6b755cfad419640159b10879e1d2dc9b97f1dae6b72"
    }
  ]
}
